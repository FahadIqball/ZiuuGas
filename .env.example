# Firebase & Google Login Configuration Template
# Duplicate this file to .env and fill in the values from your console.

# Google OAuth Web Client ID (Found in Firebase console under Google Provider settings or GCP Credentials)
GOOGLE_WEB_CLIENT_ID=689328436670-298qguqv5e6vo7oj3ekocva5tkklcus9.apps.googleusercontent.com

# Firebase Config (Optional depending on platform, but good for JS fallback/web client)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
